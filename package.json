{
  "name": "jeanmachine.dev",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "deploy": "bun install && vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^8.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "prettier": "^3.9.10",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@atcute/bluesky": "^4.0.24",
    "@atcute/lexicons": "^2.1.1",
    "@atcute/standard-site": "^2.0.2",
    "@lucide/lab": "^0.7.0",
    "@lucide/svelte": "^1.59.0",
    "@sveltejs/adapter-cloudflare": "^8.0.1",
    "@twemoji/api": "^17.0.3",
    "date-fns": "^4.4.0",
    "prettier-plugin-svelte": "^4.1.1",
    "vite-plugin-devtools-json": "^1.1.2",
    "wrangler": "^4.151.3"
  },
  "resolutions": {
    "rollup": "npm:@rollup/wasm-node"
  },
  "packageManager": "bun@1.4.3"
}
