{
  "name": "jeanmachine.dev",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "deploy": "bun install && vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
