{
  "name": "jeanmachine.dev",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "deploy": "bun install && vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "prettier": "^3.9.7",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@atcute/bluesky": "^4.0.21",
    "@atcute/lexicons": "^2.1.0",
    "@atcute/standard-site": "^2.0.2",
    "@lucide/lab": "^0.7.0",
    "@lucide/svelte": "^1.45.0",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@twemoji/api": "^17.0.3",
    "date-fns": "^4.4.0",
    "prettier-plugin-svelte": "^4.1.1",
    "vite-plugin-devtools-json": "^1.1.0",
    "wrangler": "^4.132.0"
  },
  "resolutions": {
    "rollup": "npm:@rollup/wasm-node"
  },
  "packageManager": "bun@1.2.23"
